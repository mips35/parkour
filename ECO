local toastToken = 0
local function showToast(text, color)
	if not ui.toast then
		return
	end
	toastToken += 1
	local tok = toastToken
	ui.toast.BackgroundColor3 = color
	ui.toastLabel.Text = text
	ui.toast.Visible = true
	task.delay(4, function()
		if tok == toastToken and ui.toast then
			ui.toast.Visible = false
		end
	end)
end

local function setMsg(text, kind)
	local info = MSG_COLORS[kind or "info"]
	if ui.msgFrame then
		ui.msgFrame.BackgroundColor3 = info[1]
		ui.msgLabel.Text = info[2] .. "  " .. text
	end
	-- com o painel minimizado a mensagem do rodapé não aparece: mostra um aviso na tela
	if ui.minimized then
		showToast(info[2] .. "  " .. text, info[1])
	end
end

local function setStatus(text, color)
	if not enabled then
		text, color = "Desligado", C.sub
	end
	if ui.statusLabel then
		ui.statusLabel.Text = text
		ui.statusDot.BackgroundColor3 = color
		ui.miniDot.BackgroundColor3 = color
	end
end

-- contagem grande no meio da tela (3-2-1-VAI!): aparece mesmo com o painel minimizado
local countToken = 0
local function showCount(big, caption, color, bigSize)
	if not ui.count then
		return
	end
	countToken += 1
	ui.countNum.Text = big
	ui.countNum.TextSize = bigSize or 120
	ui.countCaption.Text = caption
	ui.countStroke.Color = color
	ui.countPulse.Scale = 1.3
	ui.count.Visible = true
	TweenService:Create(ui.countPulse, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function hideCount(delay)
	countToken += 1
	local tok = countToken
	if delay and delay > 0 then
		task.delay(delay, function()
			if tok == countToken and ui.count then
				ui.count.Visible = false
			end
		end)
	elseif ui.count then
		ui.count.Visible = false
	end
end

