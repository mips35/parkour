updateCutMarkers = function()
	clearCutMarkers()
	if not enabled or (recTarget and recTarget.join) or (ui.tab ~= "edit" and not recTarget) then
		return
	end
	local rec = ensureEdit()
	if not rec then
		return
	end
	local frames = rec.frames
	local ia = frameIndexAt(frames, edit.a)
	local ib = math.max(ia, frameIndexAt(frames, edit.b))
	local down = Vector3.new(0, footOffset(), 0)
	cutFolder = make("Folder", { Name = "MarcasGravador" }, workspace)
	local textA
	if settings.editFree then
		textA = (ia > 1) and string.format("A • %.1fs  (a parte mantida termina aqui)", frames[ia].t) or "A • início original"
	else
		textA = string.format("A • %.1fs  (a regravação começa aqui)", frames[ia].t)
	end
	makeCutMarker(frames[ia].cf.Position - down, C.teal, textA)
	if ib < #frames then
		makeCutMarker(frames[ib].cf.Position - down, C.yellow, string.format("B • %.1fs  (volta ao original aqui)", frames[ib].t))
	end
end

