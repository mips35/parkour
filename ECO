	end
	local base = rec.name
	local cut = string.find(base, " (cópia)", 1, true)
	if cut then
		base = string.sub(base, 1, cut - 1) -- copiar uma cópia não empilha «(cópia) (cópia)»
	end
	local copy = {
		name = uniqueName(string.sub(base, 1, MAX_NOME - 9) .. " (cópia)"),
		frames = table.clone(rec.frames),
		duration = rec.duration,
		rows = rec.rows,
		rowKeys = rec.rowKeys,
	}
	table.insert(recs, copy)
	selected = #recs
	edit.rec = nil
	renderList()
	markDirty(true)
	setMsg("Cópia criada: «" .. copy.name .. "» (igual à original). Use «✏ Renomear» se quiser outro nome.", "ok")
end

----------------------------------------------------------------------
-- GRAVAÇÃO
----------------------------------------------------------------------
-- animação principal do movimento: a de maior peso, preferindo as de prioridade Core (andar/pular padrão do Roblox)
local function pickTrack(animator)
	local best, bestScore = nil, 0.3
	for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
		local w = tr.WeightCurrent
		if w >= 0.3 then
			local score = w + ((tr.Priority == Enum.AnimationPriority.Core) and 10 or 0)
			if score > bestScore then
				best, bestScore = tr, score
			end
		end
	end
	return best
end

local function trackKey(tr)
	local id = tr.Animation and tr.Animation.AnimationId or ""
	if id ~= "" then
		return id
	end
	return tr.Name
end

local function sample(root, hum)
	recFrames[#recFrames + 1] = {
		t = os.clock() - recStart,
		cf = root.CFrame,
		v = root.AssemblyLinearVelocity,
		m = hum.MoveDirection,
		j = hum:GetState() == Enum.HumanoidStateType.Jumping,
	}
	-- ritmo dos braços e pernas neste instante (para a imitação ficar igual)
	if recAnimator then
		local okA, tr = pcall(pickTrack, recAnimator)
		if okA and tr then
			local f = recFrames[#recFrames]
			f.s = tr.Speed
			f.k = trackKey(tr)
		end
	end
end

-- abort = true cancela uma regravação de trecho sem alterar nada
local function stopRecording(reason, abort)
	if state ~= "recording" then
		setMsg("Não há nenhuma gravação em andamento.", "warn")
		return
	end
	if recConn then
		recConn:Disconnect()
		recConn = nil
	end
	recTime = (#recFrames > 0) and recFrames[#recFrames].t or 0
	local target = recTarget
	if (target and abort) or #recFrames < 2 or recTime < 0.3 then
		recTarget = nil
		ui.cutDirty = true
		state = "idle"
		setStatus("Pronto", C.green)
		if target and abort then
			setMsg(reason or "Regravação cancelada. Nada foi alterado.", "warn")
		elseif target then
			setMsg("Trecho muito curto, foi descartado. Nada foi alterado.", "warn")
		else
			setMsg("Gravação muito curta, foi descartada. Tente de novo!", "warn")
		end
		return
	end
	local note = nil
	if settings.straighten then
		local nf, maxShift = straightenFrames(recFrames, settings.straightTol)
		if nf and maxShift > 0.05 then
			recFrames = nf
			note = string.format(" Linhas retas aplicadas (desvio máximo de %.2f studs).", maxShift)
		end
	end
	if target then
		finishEdit(recFrames, note)
		return
	end
	state = "naming"
	pending = { frames = recFrames, duration = recTime }
	setStatus("Aguardando nome", C.yellow)
	setMsg((reason or "Gravação parada! Dê um nome para salvar.") .. (note or ""), "info")
	openNameDialog("save")
end

local function beginRecording(target)
	if state ~= "idle" then
		busyMessage()
		return
	end
	local _, hum, root = getCharacter()
	if not root then
		setMsg("Seu personagem não está pronto (ou está morto).", "err")
		return
	end
	recFrames = {}
	recStart = os.clock()
	recTime = 0
	recTarget = target
	recAnimator = hum:FindFirstChildOfClass("Animator")
	sample(root, hum)
	state = "recording"
	recConn = RunService.Heartbeat:Connect(function()
		local _, h, r = getCharacter()
		if not r then
			stopRecording("Seu personagem foi removido — " .. (recTarget and "a regravação foi cancelada e nada foi alterado." or "a gravação foi encerrada."), true)
			return
		end
		sample(r, h)
		local el = os.clock() - recStart
		local tg = recTarget
		if tg then
			if tg.join then
				local _, dist = nearestIndex(tg.pts, r.Position)
				tg.dist = dist
				if dist <= settings.tolerance and el > 0.4 then
					stopRecording("Encostou no trajeto antigo — juntando os dois!")
					return
				end
			elseif tg.stopPos and settings.stopAtCut then
				local d = (r.Position - tg.stopPos).Magnitude
				if not tg.armed and d > settings.tolerance + 1.5 then
					tg.armed = true
				end
				if tg.armed and d <= settings.tolerance then
					stopRecording("Chegou no ponto B — trecho gravado!")
					return
				end
			end
			setStatus(string.format("● Regravando  %.1fs", el), C.red)
		else
			setStatus(string.format("● Gravando  %.1fs", el), C.red)
		end
	end)
	if target and target.join then
		setStatus("● Novo início  0.0s", C.red)
		setMsg("Gravando o novo início! Ande até ENCOSTAR no trajeto antigo: a gravação para sozinha e os dois se juntam (ou pressione [" .. keyName("stop") .. "]).", "ok")
	elseif target then
		local how = (target.stopPos and settings.stopAtCut) and (" Para sozinho ao chegar no ponto B (ou pressione [" .. keyName("stop") .. "]).") or (" Pressione [" .. keyName("stop") .. "] para terminar.")
		setStatus("● Regravando  0.0s", C.red)
		setMsg("Regravando o trecho! Faça o movimento." .. how, "ok")
	else
		setStatus("● Gravando  0.0s", C.red)
		setMsg("Gravando! Ande, pule e gire à vontade. Pressione [" .. keyName("stop") .. "] para parar.", "ok")
	end
end

local function startRecording()
	beginRecording(nil)
end

local function stopRecordingAction()
	stopRecording()
end

----------------------------------------------------------------------
-- IR AO PONTO INICIAL / POSICIONAR
----------------------------------------------------------------------
local function reportDistance(rec)
	local _, _, r = getCharacter()
	if not r then
		setMsg("Seu personagem não está disponível.", "err")
		return
	end
	local d = (r.Position - rec.frames[1].cf.Position).Magnitude
	if d <= settings.tolerance then
		setMsg(string.format("Você está no ponto inicial de «%s» (a %.1f studs). Pressione [%s] para iniciar a imitação.", rec.name, d, keyName("play")), "ok")
	elseif settings.mode == "tp" and not settings.walkGoto then
		setMsg(string.format("O jogo te levou de volta: você está a %.1f studs do início. Provável anti-teleporte — em Ajustes, troque para o modo Natural.", d), "err")
	else
		setMsg(string.format("Não consegui chegar ao início (a %.1f studs). Pode haver obstáculo ou diferença de altura.", d), "err")
	end
end

-- ===== andar até o ponto: calcula a rota INTEIRA primeiro, depois anda sem recalcular =====
function geo.horizDist(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- vai até 'target' em linha reta (um só ponto); se ficar parado perto de algo, pula. Devolve true se chegou.
function geo.moveStep(target, timeout, reach)
	local t0 = os.clock()
	local lastMove = -math.huge
	local lastPos, stuck = nil, 0
	while state == "walking" and os.clock() - t0 < timeout do
		local _, h, r = getCharacter()
		if not r then
			return false
		end
		if geo.horizDist(r.Position, target) <= reach then
			return true
		end
		if os.clock() - lastMove > 5 then -- o MoveTo expira em ~8s: renova
			h:MoveTo(target)
			lastMove = os.clock()
		end
		if lastPos and (r.Position - lastPos).Magnitude < 0.2 then
			stuck += 1
			if stuck >= 4 then -- ~0,4s parado: tenta pular o obstáculo
				h.Jump = true
				stuck = 0
			end
		else
			stuck = 0
		end
		lastPos = r.Position
		task.wait(0.1)
	end
	return false
end

-- anda por uma lista de pontos JÁ CALCULADA, sem recalcular nada no meio (isso evita a travadinha):
-- troca para o próximo ponto um pouco ANTES de chegar no atual, para não parar e arrancar de novo a
-- cada ponto. Pula sozinho se ficar preso contra algo. Devolve true se chegou no último ponto.
function geo.moveAlongPath(points, timeout)
	local t0 = os.clock()
	local i = 1
	local lastPos, stuck = nil, 0
	local _, h = getCharacter()
	if not h then
		return false
	end
	h:MoveTo(points[1])
	while state == "walking" and os.clock() - t0 < timeout do
		local _, h2, r2 = getCharacter()
		if not r2 then
			return false
		end
		local d = geo.horizDist(r2.Position, points[i])
		if i == #points then
			if d <= 1 then
				return true
			end
		elseif d <= 3.5 then -- "larga a mão" um pouco antes de chegar: segue pro próximo sem parar de vez
			i += 1
			h2:MoveTo(points[i])
		end
		if lastPos and (r2.Position - lastPos).Magnitude < 0.2 then
			stuck += 1
			if stuck >= 4 then -- ~0,4s parado: tenta pular o obstáculo
				h2.Jump = true
				stuck = 0
			end
		else
			stuck = 0
		end
		lastPos = r2.Position
		task.wait(0.1)
	end
	return false
end

-- calcula a rota inteira até o ponto (contornando o que estiver no caminho) e só então anda por ela,
-- de uma vez, sem recalcular. Sem rota encontrada: tenta ir direto mesmo assim, pulando o que puder.
function geo.walkRoute(goalCF, onPlanned)
	local _, _, r = getCharacter()
	if not r then
		return false
	end
	local down = Vector3.new(0, footOffset(), 0)
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 4 })
	local okCompute = pcall(function()
		path:ComputeAsync(r.Position - down, goalCF.Position - down)
	end)
	if state ~= "walking" then
		return false
	end
	if okCompute and path.Status == Enum.PathStatus.Success then
		local pts = {}
		for _, wp in ipairs(path:GetWaypoints()) do
			pts[#pts + 1] = wp.Position
		end
		if #pts > 0 then
			if onPlanned then
				onPlanned(#pts)
			end
			return geo.moveAlongPath(pts, 45)
		end
	end
	-- sem rota (ou PathfindingService indisponível neste ambiente): tenta ir direto mesmo assim
	if onPlanned then
		onPlanned(nil)
	end
	return geo.moveStep(goalCF.Position, 45, 0.6)
end
-- anda até a posição de um CFrame e chama onArrive(chegou) quando terminar
local function walkToCF(cf, onArrive)
	state = "walking"
	setStatus("🧭 Calculando a rota", C.teal)
	setMsg("Calculando a rota até o ponto… ([" .. keyName("stopplay") .. "] cancela)", "info")
	task.spawn(function()
		local okW, errW = pcall(geo.walkRoute, cf, function(numPts)
			if state ~= "walking" then
				return
			end
			setStatus("🚶 Indo ao ponto", C.teal)
			if numPts then
				setMsg(string.format("Rota encontrada (%d pontos)! Indo até lá, contornando o que estiver no caminho. ([%s] cancela)", numPts, keyName("stopplay")), "info")
			else
				setMsg("Não achei uma rota contornando; indo direto mesmo assim, pulando o que puder. ([" .. keyName("stopplay") .. "] cancela)", "warn")
			end
		end)
		if not okW then
			warn("[Gravador] caminhada: " .. tostring(errW))
		end
		if state ~= "walking" then
			return
		end
		state = "idle"
		setStatus("Pronto", C.green)
		local _, h2, r2 = getCharacter()
		if not r2 then
			setMsg("Seu personagem não está disponível.", "err")
			return
		end
		h2:Move(Vector3.zero, false)
		h2:MoveTo(r2.Position) -- para de andar
		local arrived = geo.horizDist(r2.Position, cf.Position) <= 1.5
		r2.CFrame = CFrame.new(r2.Position) * cf.Rotation -- só ajusta a direção do olhar
		task.wait(0.2)
		if state == "idle" and onArrive then
			onArrive(arrived)
		end
	end)
end
local function goToStart()
	if state ~= "idle" then
		busyMessage()
		return
	end
	local rec = selectedRec()
	if not rec then
		return
	end
	local _, hum, root = getCharacter()
	if not root then
		setMsg("Seu personagem não está pronto.", "err")
		return
	end
	if settings.mode == "nat" or settings.walkGoto then
		walkToCF(rec.frames[1].cf, function()
			reportDistance(rec)
		end)
		return
	end
	hum.Sit = false
	root.CFrame = rec.frames[1].cf
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	setMsg("Teleportando para o ponto inicial…", "info")
	task.delay(0.3, function()
		if state == "idle" then
			reportDistance(rec)
		end
	end)
end

-- leva o personagem até uma pose, faz a contagem 3-2-1 e chama onReady
local function prepareAt(cf, vel, text, onReady, stay)
	local _, hum, root = getCharacter()
	if not root then
		setMsg("Seu personagem não está pronto.", "err")
		return
	end
	local function countdown()
		state = "countdown"
		ui.countHint.Text = "[" .. keyName("stopplay") .. "] cancela"
		setMsg(string.format("%s Contagem de %d segundos: quando aparecer VAI!, comece a andar.  ([%s] cancela)", text, COUNTDOWN, keyName("stopplay")), "info")
		for n = COUNTDOWN, 1, -1 do
			if state ~= "countdown" then
				return
			end
			setStatus("⏳ Começa em " .. n, C.yellow)
			showCount(tostring(n), "Prepare-se! Quando aparecer VAI!, comece a andar.", C.yellow, 120)
			task.wait(1)
		end
		if state ~= "countdown" then
			return
		end
		local _, _, r = getCharacter()
		if not r then
			state = "idle"
			hideCount()
			setStatus("Pronto", C.green)
			setMsg("Seu personagem não está disponível.", "err")
			return
		end
		r.Anchored = false
		if settings.mode == "tp" and not stay then
			r.AssemblyLinearVelocity = vel -- continua com o embalo que tinha nesse ponto
		end
		state = "idle"
		showCount("VAI!", "Pode andar! A regravação já começou.", C.green, 72)
		hideCount(1.1)
		onReady()
	end
	if stay then
		state = "countdown" -- sem teleporte: só a contagem, no lugar onde você está
		task.spawn(countdown)
	elseif settings.mode == "tp" and not settings.walkGoto then
		hum.Sit = false
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.Anchored = true -- fica parado durante a contagem
		state = "countdown"
		task.spawn(countdown)
	else
		walkToCF(cf, function(arrived)
			if not arrived then
				setMsg("Não consegui chegar ao ponto (obstáculo grande ou sem caminho). Tente de novo, ou use o Teleporte / «Início: onde estou».", "err")
				return
			end
			countdown()
		end)
	end
end

----------------------------------------------------------------------
-- IMITAÇÃO
----------------------------------------------------------------------
local function endPlayback(text, kind)
	if playConn then
		playConn:Disconnect()
		playConn = nil
	end
	if playConn2 then
		playConn2:Disconnect()
		playConn2 = nil
	end
	if playConn3 then
		playConn3:Disconnect()
		playConn3 = nil
	end
	if playHum and playHum.Parent then
		playHum.AutoRotate = playOldAuto
	end
	playHum = nil
	setControls(true)
	local _, hum = getCharacter()
	if hum then
		hum:Move(Vector3.zero, false)
	end
	state = "idle"
	setStatus("Pronto", C.green)
	setMsg(text, kind)
end

local function startPlayback()
	if state ~= "idle" then
		busyMessage()
		return
	end
	local rec = selectedRec()
	if not rec then
		return
	end
	local _, hum, root = getCharacter()
	if not root then
		setMsg("Seu personagem não está pronto.", "err")
		return
	end

	local frames = rec.frames
	local dist = (root.Position - frames[1].cf.Position).Magnitude
	if dist > settings.tolerance then
		setMsg(string.format("Você está a %.1f studs do ponto inicial (máximo %.1f). Pressione [%s] para ir ao local certo.", dist, settings.tolerance, keyName("goto")), "err")
		return
	end

	state = "playing"
	setControls(false)
	playHum = hum
	playOldAuto = hum.AutoRotate
	hum.AutoRotate = false
	setMsg("Imitando «" .. rec.name .. "»… Para interromper, pressione [" .. keyName("stopplay") .. "].", "ok")

	local startClock = os.clock()
	local idx, pendingJump, badTime, lastT = 1, false, 0, 0
	local lastApplied = frames[1].cf
	local total = frames[#frames].t

	-- devolve a pose gravada no instante t (interpolada entre dois frames)
	local function evaluate(t)
		while idx < #frames and frames[idx + 1].t <= t do
			idx += 1
			if frames[idx].j and not frames[idx - 1].j then
				pendingJump = true
			end
		end
		local a, b = frames[idx], frames[idx + 1]
		if not b then
			return a.cf, Vector3.zero, Vector3.zero, true
		end
		local alpha = math.clamp((t - a.t) / math.max(b.t - a.t, 1e-6), 0, 1)
		return a.cf:Lerp(b.cf, alpha), a.v:Lerp(b.v, alpha), a.m, false
	end

	local function step(isPre)
		if state ~= "playing" then
			return
		end
		if not isPre and settings.mode ~= "tp" then
			return
		end
		local _, h, r = getCharacter()
		if not r then
			endPlayback("A imitação foi interrompida: seu personagem foi removido.", "warn")
			return
		end
		local t = os.clock() - startClock
		local cf, vel, moveDir, finished = evaluate(t)

		if isPre then
			if settings.mode == "tp" then
				-- se o jogo desfaz nosso teleporte por muito tempo, avisa em vez de insistir
				if (r.Position - lastApplied.Position).Magnitude > 12 then
					badTime += (t - lastT)
				else
					badTime = 0
				end
				if badTime > 0.4 then
					endPlayback("O jogo está desfazendo o teleporte (anti-cheat?). Em Ajustes, troque para o modo Natural.", "err")
					return
				end
			end
			lastT = t
			setStatus(string.format("▶ Imitando %.1f/%.1fs", math.min(t, total), total), C.blue)
		end

		if settings.mode == "tp" then
			r.CFrame = cf
			r.AssemblyLinearVelocity = finished and Vector3.zero or vel
			r.AssemblyAngularVelocity = Vector3.zero
			lastApplied = cf
		else
			local err = cf.Position - r.Position
			if err.Magnitude > 10 then
				r.CFrame = cf
				r.AssemblyLinearVelocity = vel
			else
				r.CFrame = CFrame.new(r.Position) * cf.Rotation
				r.AssemblyLinearVelocity = vel + err * 10
			end
		end

		if isPre then
			h:Move(moveDir, false)
			if pendingJump then
				pendingJump = false
				h:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end

		if finished then
			endPlayback("Imitação de «" .. rec.name .. "» concluída!", "ok")
		end
	end

	local function guarded(isPre)
		local ok, err = pcall(step, isPre)
		if not ok then
			warn("[Gravador] " .. tostring(err))
			endPlayback("Erro durante a imitação: " .. tostring(err), "err")
		end
	end

	playConn = RunService.PreSimulation:Connect(function()
		guarded(true)
	end)
	playConn2 = RunService.Heartbeat:Connect(function()
		guarded(false)
	end)

	-- ritmo da animação: braços e pernas seguem o mesmo ritmo de quando você gravou
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		local function applyAnim(f)
			if f.s and f.k then
				for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
					if trackKey(tr) == f.k and math.abs(tr.Speed - f.s) > 0.01 then
						tr:AdjustSpeed(f.s)
					end
				end
			elseif not f.j and math.abs(f.v.Y) < 3 then
				-- gravação antiga (sem o ritmo anotado): regra padrão do Roblox, velocidade ÷ 16
				local sp = math.sqrt(f.v.X * f.v.X + f.v.Z * f.v.Z)
				if sp > 0.75 then
					local tr = pickTrack(animator)
					local want = sp / 16
					if tr and math.abs(tr.Speed - want) > 0.02 then
						tr:AdjustSpeed(want)
					end
				end
			end
		end
		playConn3 = RunService.RenderStepped:Connect(function()
			if state ~= "playing" or not animator.Parent then
				return
			end
			local f = frames[idx]
			if f then
				pcall(applyAnim, f)
			end
		end)
	end
	setStatus("▶ Imitando", C.blue)
end

local function stopPlayback()
	if state == "playing" then
		endPlayback("Imitação interrompida.", "warn")
	elseif state == "walking" then
		state = "idle"
		local _, h, r = getCharacter()
		if h and r then
			h:MoveTo(r.Position)
		end
		setStatus("Pronto", C.green)
		setMsg("Caminhada cancelada.", "warn")
	elseif state == "countdown" then
		state = "idle"
		hideCount()
		local _, _, r = getCharacter()
		if r then
			r.Anchored = false
		end
		setStatus("Pronto", C.green)
		setMsg("Contagem cancelada. Nada foi alterado.", "warn")
	else
		setMsg("Nenhuma imitação está rodando agora.", "info")
	end
end

