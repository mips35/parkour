-- SALVAMENTO EM ARQUIVO LOCAL (writefile / readfile)
----------------------------------------------------------------------
local function buildFile()
	local parts = {}
	for i, r in ipairs(recs) do
		parts[i] = recJSON(r)
	end
	local keys = {}
	for id, kc in pairs(binds) do
		keys[id] = kc.Name
	end
	local cfg = {
		mode = settings.mode,
		tolerance = settings.tolerance,
		marker = settings.marker,
		path = settings.path,
		autosave = settings.autosave,
		stopAtCut = settings.stopAtCut,
		editCopy = settings.editCopy,
		editFree = settings.editFree,
		hideMini = settings.hideMini,
		straighten = settings.straighten,
		straightTol = settings.straightTol,
		walkGoto = settings.walkGoto,
		guideMode = settings.guideMode,
		dummyInterval = settings.dummyInterval,
		binds = keys,
		selected = (selected and recs[selected]) and recs[selected].name or nil,
	}
	return '{"v":2,"cfg":' .. HttpService:JSONEncode(cfg) .. ',"recs":[' .. table.concat(parts, ",") .. "]}"
end

saveNow = function(manual)
	if not canFile then
		if manual then
			setMsg("Este ambiente não deixa o script criar arquivos (faltam writefile/readfile). Use «Exportar» → «Exportar todas» para guardar o texto.", "warn")
		end
		return false
	end
	local ok, err = pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(FOLDER) then
			makefolder(FOLDER)
		end
		writefile(FILE, buildFile())
	end)
	if ok then
		store.dirty = false
		store.lastSave = os.date("%H:%M:%S")
		if manual then
			setMsg(string.format("Salvo! %d gravação(ões) guardadas em «%s».", #recs, FILE), "ok")
		end
	else
		warn("[Gravador] erro ao salvar: " .. tostring(err))
		setMsg("Não consegui salvar o arquivo: " .. tostring(err), "err")
	end
	if refreshStoreInfo then
		refreshStoreInfo()
	end
	return ok
end

-- marca que há algo novo para salvar; "immediate" salva na hora, senão espera 1,5s (agrupa mudanças)
markDirty = function(immediate)
	store.dirty = true
	if not (canFile and settings.autosave) or store.loading then
		return
	end
	store.token += 1
	local tok = store.token
	if immediate then
		saveNow(false)
	else
		task.delay(1.5, function()
			if tok == store.token and store.dirty and state ~= "recording" then
				saveNow(false)
			end
		end)
	end
end

