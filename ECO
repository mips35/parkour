local function updateEditInfo()
	if not ui.editInfo then
		return
	end
	local rec = ensureEdit()
	if not rec then
		ui.editInfo.Text = '<font color="rgb(245,190,70)">Nenhuma gravação selecionada.</font> Clique numa na lista da esquerda para escolher qual trecho refazer.'
		return
	end
	local frames = rec.frames
	local ia = frameIndexAt(frames, edit.a)
	local ib = math.max(ia, frameIndexAt(frames, edit.b))
	local ta, tb = frames[ia].t, frames[ib].t
	local hasTail = ib < #frames
	local lines = { string.format("<b>%s</b>  (%.1fs no total)", esc(rec.name), rec.duration) }
	if ia > 1 then
		lines[#lines + 1] = string.format('<font color="rgb(50,170,200)">Mantém o começo:</font> 0.0s → %.1fs', ta)
	else
		lines[#lines + 1] = '<font color="rgb(50,170,200)">Começo:</font> nada mantido (refaz desde o início)'
	end
	if hasTail then
		lines[#lines + 1] = string.format("<b>Regrava:</b> %.1fs → %.1fs", ta, tb)
		lines[#lines + 1] = string.format('<font color="rgb(245,190,70)">Mantém o final:</font> %.1fs → %.1fs', tb, rec.duration)
	else
		lines[#lines + 1] = string.format("<b>Regrava:</b> %.1fs → fim", ta)
		lines[#lines + 1] = '<font color="rgb(245,190,70)">Final:</font> nada mantido (refaz até o fim)'
	end
	local _, _, root = getCharacter()
	if state == "recording" and recTarget then
		local extra = ""
		if recTarget.join then
			if recTarget.dist then
				extra = string.format("   •   a %.1f studs do trajeto antigo (encosta com ≤ %.1f)", recTarget.dist, settings.tolerance)
			end
			lines[#lines + 1] = '<font color="rgb(232,84,84)"><b>● Gravando o novo início…</b></font>' .. extra
		else
			if recTarget.stopPos and root then
				extra = string.format("   •   distância até o ponto B: %.1f studs", (root.Position - recTarget.stopPos).Magnitude)
			end
			lines[#lines + 1] = '<font color="rgb(232,84,84)"><b>● Regravando o trecho…</b></font>' .. extra
		end
	elseif root then
		local d = (root.Position - frames[ia].cf.Position).Magnitude
		local _, dPath = nearestIndex(getPts(rec), root.Position)
		if settings.editFree then
			lines[#lines + 1] = string.format('<font color="rgb(150,158,180)">Início livre • a %.1f studs do ponto A e a %.1f do trajeto.</font>', d, dPath)
		else
			lines[#lines + 1] = string.format('<font color="rgb(150,158,180)">A %.1f studs do ponto A e a %.1f studs do trajeto.</font>', d, dPath)
		end
	end
	ui.editInfo.Text = table.concat(lines, "\n")
end

