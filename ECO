local function closeNameDialog()
	ui.overlay.Visible = false
	ui.nameBox:ReleaseFocus()
	ui.renaming = nil
end

local function confirmName()
	if state ~= "naming" then
		return
	end
	local name = ui.nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

	if ui.nameMode == "rename" then
		local rec = ui.renaming
		if not rec then
			return
		end
		if name == "" then
			name = rec.name
		end
		name = uniqueName(string.sub(name, 1, MAX_NOME), rec)
		local old = rec.name
		rec.name = name
		closeNameDialog()
		state = "idle"
		setStatus("Pronto", C.green)
		renderList()
		markDirty(true)
		setMsg("«" .. old .. "» agora se chama «" .. name .. "».", "ok")
		return
	end

	if not pending then
		return
	end
	if name == "" then
		name = "Gravação " .. (#recs + 1)
	end
	name = string.sub(name, 1, MAX_NOME)
	name = uniqueName(name)

	local rec = { name = name, frames = pending.frames, duration = pending.duration }
	table.insert(recs, rec)
	selected = #recs
	edit.rec = nil
	pending = nil
	closeNameDialog()
	state = "idle"
	setStatus("Pronto", C.green)
	renderList()
	markDirty(true)
	setMsg("Gravação «" .. name .. "» salva e selecionada! Na aba Reproduzir: [" .. keyName("goto") .. "] vai ao início e [" .. keyName("play") .. "] imita.", "ok")
end

local function cancelName()
	if state ~= "naming" then
