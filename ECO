----------------------------------------------------------------------
-- TROCAR TECLAS
----------------------------------------------------------------------
local function beginRebind(id)
	if state ~= "idle" then
		busyMessage()
		return
	end
	rebindingId = id
	refreshKeys()
	setMsg("Pressione a nova tecla para «" .. ACTION_BY_ID[id].title .. "».  (Esc cancela)", "warn")
end

local function handleRebind(input)
	local kc = input.KeyCode
	if kc == Enum.KeyCode.Unknown then
		return
	end
	local id = rebindingId
	if kc == Enum.KeyCode.Escape then
		rebindingId = nil
		refreshKeys()
		setMsg("Troca de tecla cancelada.", "info")
		return
	end
	if BLOCKED_KEYS[kc] then
		setMsg("A tecla " .. kc.Name .. " é usada para andar/pular. Escolha outra.", "err")
		return
	end
	for otherId, other in pairs(binds) do
		if otherId ~= id and other == kc then
			setMsg("A tecla " .. kc.Name .. " já é usada por «" .. ACTION_BY_ID[otherId].title .. "». Escolha outra.", "err")
			return
		end
	end
	binds[id] = kc
	rebindingId = nil
	refreshKeys()
	refreshHelp()
	markDirty()
	setMsg("Pronto! «" .. ACTION_BY_ID[id].title .. "» agora usa a tecla [" .. kc.Name .. "].", "ok")
end

