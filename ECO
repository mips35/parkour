	local plus = button({ Text = "▶", TextSize = 13, BackgroundColor3 = C.panel, Size = UDim2.fromOffset(32, 26), Position = UDim2.new(1, -38, 0, 3) }, card)
	corner(minus, 7)
	corner(plus, 7)
	local here = button({ Text = "📍 Aqui", TextSize = 11, BackgroundColor3 = C.blueDark, Size = UDim2.fromOffset(62, 26), Position = UDim2.new(1, -226, 0, 3) }, card)
	corner(here, 7)
	here.MouseButton1Click:Connect(safe(function()
		markPoint(which)
	end))

	local track = make("Frame", { Size = UDim2.new(1, -28, 0, 8), Position = UDim2.fromOffset(14, 42), BackgroundColor3 = C.panel }, card)
	corner(track, 4)
	local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color }, track)
	corner(fill, 4)
	local knob = make("Frame", { Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = C.white }, track)
	corner(knob, 9)
	local hit = button({ Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 33) }, card)
	label({ Text = hintText, TextSize = 11, TextColor3 = C.sub, Size = UDim2.new(1, -24, 0, 14), Position = UDim2.fromOffset(12, 56), TextTruncate = Enum.TextTruncate.AtEnd }, card)

	local dragging, dragType = false, nil
	local function fromInput(input)
		local rec = ensureEdit()
		if not rec then
			return
		end
		local x = (input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1)
		setEditValue(which, math.clamp(x, 0, 1) * rec.duration)
	end
	hit.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
			return
		end
		if state ~= "idle" then
			busyMessage()
			return
		end
		if not ensureEdit() then
			setMsg("Selecione uma gravação na lista da esquerda primeiro.", "warn")
			return
		end
		dragging, dragType = true, t
		fromInput(input)
	end)
	onGlobal(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		local t = input.UserInputType
		if (dragType == Enum.UserInputType.MouseButton1 and t == Enum.UserInputType.MouseMovement) or (dragType == Enum.UserInputType.Touch and t == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end)
	onGlobal(UserInputService.InputEnded, function(input)
		if dragging and input.UserInputType == dragType then
			dragging = false
		end
	end)

	local function nudge(delta)
		if state ~= "idle" then
			busyMessage()
			return
		end
		if not ensureEdit() then
			setMsg("Selecione uma gravação na lista da esquerda primeiro.", "warn")
			return
		end
		setEditValue(which, (which == "a" and edit.a or edit.b) + delta)
	end
	minus.MouseButton1Click:Connect(function()
		nudge(-0.1)
	end)
	plus.MouseButton1Click:Connect(function()
		nudge(0.1)
	end)

	-- devolve a função que redesenha o controle
	return function(t, dur)
		local r = (dur > 0) and math.clamp(t / dur, 0, 1) or 0
		knob.Position = UDim2.fromScale(r, 0.5)
		if which == "a" then
			fill.Position = UDim2.fromScale(0, 0)
			fill.Size = UDim2.fromScale(r, 1)
		else
			fill.Position = UDim2.fromScale(r, 0)
			fill.Size = UDim2.fromScale(1 - r, 1)
		end
		valueLbl.Text = string.format("%.1fs", t)
	end
end

