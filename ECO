		label({
			Text = rec.name,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			Size = UDim2.new(1, -40, 0, 22),
			Position = UDim2.fromOffset(10, 6),
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, item)
		label({
			Text = string.format("⏱ %.1fs   •   %d pontos", rec.duration, #rec.frames),
			TextSize = 12,
			TextColor3 = C.sub,
			Size = UDim2.new(1, -20, 0, 18),
			Position = UDim2.fromOffset(10, 28),
		}, item)
		if i == selected then
			label({
				Text = "✔",
				Font = Enum.Font.GothamBold,
				TextSize = 18,
				TextColor3 = C.green,
				TextXAlignment = Enum.TextXAlignment.Right,
				Size = UDim2.new(1, -12, 0, 22),
				Position = UDim2.fromOffset(0, 6),
			}, item)
		end
		item.MouseButton1Click:Connect(function()
			if state ~= "idle" then
				busyMessage()
				return
			end
			selected = i
			edit.rec = nil
			renderList()
			setMsg("Gravação «" .. rec.name .. "» selecionada. Na aba Reproduzir: [" .. keyName("goto") .. "] vai ao início e [" .. keyName("play") .. "] imita.", "ok")
		end)
	end
	-- os guias visuais nunca podem atrapalhar o resto: qualquer erro aqui só vira aviso
	local okMarker, errMarker = pcall(updateMarker)
	if not okMarker then
		warn("[Gravador] marcador: " .. tostring(errMarker))
	end
	local okPath, errPath = pcall(updatePath)
	if not okPath then
		warn("[Gravador] trajeto: " .. tostring(errPath))
	end
	local okCut, errCut = pcall(updateCutMarkers)
	if not okCut then
		warn("[Gravador] pontos A/B: " .. tostring(errCut))
	end
	if refreshEdit then
		pcall(refreshEdit)
	end
	ui.anaDirty = true
	if updateSummary then
		pcall(updateSummary)
	end
end

