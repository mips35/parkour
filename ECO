----------------------------------------------------------------------
-- REGRAVAR UM TRECHO
----------------------------------------------------------------------
-- monta a gravação nova: começo mantido + trecho novo + final mantido
local function mergeFrames(old, ia, ib, hasTail, new, free)
	local out = {}
	local t0
	if free then
		-- começou de onde estava: mantém o ponto A e desliza até o primeiro frame do trecho novo
		if ia > 1 then
			for i = 1, ia do
				out[#out + 1] = old[i]
			end
			local gap = (old[ia].cf.Position - new[1].cf.Position).Magnitude
			t0 = old[ia].t + ((gap < 0.25) and (1 / 60) or math.clamp(gap / 20, 0.05, 2))
		else
			t0 = 0
		end
	else
		for i = 1, ia - 1 do
			out[#out + 1] = old[i]
		end
		t0 = old[ia].t
	end
	for _, f in ipairs(new) do
		out[#out + 1] = { t = t0 + f.t, cf = f.cf, v = f.v, m = f.m, j = f.j, s = f.s, k = f.k }
	end
	if hasTail then
		local last = out[#out]
		local gap = (last.cf.Position - old[ib].cf.Position).Magnitude
		local gapT = (gap < 0.25) and (1 / 60) or math.clamp(gap / 20, 0.05, 2)
		local shift = last.t + gapT - old[ib].t
		for j = ib, #old do
			local f = old[j]
			out[#out + 1] = { t = f.t + shift, cf = f.cf, v = f.v, m = f.m, j = f.j, s = f.s, k = f.k }
		end
	end
	return out
end

finishEdit = function(newFrames, note)
	local t = recTarget
	recTarget = nil
	ui.cutDirty = true
	local rec = t.rec
	local joinT = nil
	if t.join then
		-- em que ponto do trajeto antigo o novo início encostou? (frame mais próximo do último ponto gravado)
		t.ib = nearestIndex(t.pts, newFrames[#newFrames].cf.Position)
		t.hasTail = t.ib < #rec.frames
		joinT = rec.frames[t.ib].t
	end
	local last = newFrames[#newFrames]
	local gap = t.hasTail and (last.cf.Position - rec.frames[t.ib].cf.Position).Magnitude or 0
	local headGap = (t.free and t.ia > 1) and (rec.frames[t.ia].cf.Position - newFrames[1].cf.Position).Magnitude or 0
	local out = mergeFrames(rec.frames, t.ia, t.ib, t.hasTail, newFrames, t.free)
	local dur = out[#out].t
	local name = rec.name
	if settings.editCopy then
		local copy = {
			name = uniqueName(string.sub(rec.name, 1, MAX_NOME - 10) .. " (editada)"),
			frames = out,
			duration = dur,
		}
		table.insert(recs, copy)
		selected = #recs
		name = copy.name
	else
		rec.undo = { frames = rec.frames, duration = rec.duration }
		rec.frames = out
		rec.duration = dur
		rec.rows = nil
		rec.stats = nil
		rec.pts = nil
	end
	edit.rec = nil
	state = "idle"
	setStatus("Pronto", C.green)
	renderList()
	markDirty(true)
	local msg
	if t.join then
		msg = string.format("Novo início encaixado no trajeto antigo (aos %.1fs dele)! «%s» agora tem %.1fs. ", joinT, name, dur)
	else
		msg = string.format("Trecho regravado! «%s» agora tem %.1fs. ", name, dur)
	end
	msg ..= settings.editCopy and "Foi salvo como cópia; a original continua igual." or "Se não gostou, use «Desfazer»."
	msg ..= note or ""
	local attention = false
	if headGap > 6 then
		msg ..= string.format(" Atenção: você começou a %.1f studs do ponto A; na imitação o personagem desliza até o trecho novo.", headGap)
		attention = true
	end
	if gap > 6 then
		msg ..= string.format(" Atenção: você parou a %.1f studs " .. (t.join and "do trajeto antigo" or "do ponto B") .. "; na imitação o personagem desliza até lá.", gap)
		attention = true
	end
	setMsg(msg, attention and "warn" or "ok")
end

local function startEditRecording()
	if state ~= "idle" then
		busyMessage()
		return
	end
	local rec = selectedRec()
	if not rec then
		return
	end
	local _, _, root = getCharacter()
	if not root then
		setMsg("Seu personagem não está pronto.", "err")
		return
	end
	ensureEdit()
	local frames = rec.frames
	local ia = frameIndexAt(frames, edit.a)
	local ib = math.max(ia, frameIndexAt(frames, edit.b))
	local hasTail = ib < #frames
	local target = {
		rec = rec,
		ia = ia,
		ib = ib,
		hasTail = hasTail,
		stopPos = hasTail and frames[ib].cf.Position or nil,
		armed = false,
		free = settings.editFree,
	}
	local text
	if settings.editFree then
		text = "Sem teleporte: a regravação começa de onde você está."
	elseif ia == 1 then
		text = "Posicionado no início original."
	else
		text = string.format("Posicionado no ponto A (%.1fs).", frames[ia].t)
	end
	prepareAt(frames[ia].cf, frames[ia].v, text, function()
		beginRecording(target)
	end, settings.editFree)
end

-- grava um NOVO começo a partir de onde você está; ao encostar no trajeto antigo, os dois se juntam
local function startJoinRecording()
	if state ~= "idle" then
		busyMessage()
		return
	end
	local rec = selectedRec()
	if not rec then
		return
	end
	local _, _, root = getCharacter()
	if not root then
		setMsg("Seu personagem não está pronto.", "err")
		return
	end
	local pts = getPts(rec)
	local _, nearest = nearestIndex(pts, root.Position)
	if nearest <= settings.tolerance then
		setMsg(string.format("Você está em cima do trajeto antigo (a %.1f studs). Vá até o NOVO ponto inicial, fora do trajeto (a mais de %.1f studs dele), e tente de novo.", nearest, settings.tolerance), "warn")
		return
	end
	local target = {
		rec = rec,
		ia = 1,
		ib = #rec.frames,
		hasTail = true,
		join = true,
		free = true,
		pts = pts,
		armed = false,
	}
	local text = "Novo início a partir de onde você está: ande até encostar no trajeto antigo."
	if not settings.path then
		text ..= " (Dica: ligue «Trajeto» em Ajustes para ver o caminho antigo.)"
	end
	prepareAt(root.CFrame, Vector3.zero, text, function()
		beginRecording(target)
	end, true)
end

-- guarda o resultado de uma edição: substitui (com Desfazer) ou cria uma cópia, conforme a opção escolhida
local function commitFrames(rec, frames, suffix)
	local dur = frames[#frames].t
	local name = rec.name
	if settings.editCopy then
		local copy = {
			name = uniqueName(string.sub(rec.name, 1, MAX_NOME - #suffix) .. suffix),
			frames = frames,
			duration = dur,
		}
		table.insert(recs, copy)
		selected = #recs
		name = copy.name
	else
		rec.undo = { frames = rec.frames, duration = rec.duration }
		rec.frames = frames
		rec.duration = dur
		rec.rows = nil
		rec.stats = nil
		rec.pts = nil
	end
	edit.rec = nil
	renderList()
	markDirty(true)
	return name
end

-- «linhas retas» numa gravação que já existe
local function straightenSelected()
	if state ~= "idle" then
		busyMessage()
		return
	end
	local rec = selectedRec()
	if not rec then
		return
	end
	local nf, maxShift, before, after = straightenFrames(rec.frames, settings.straightTol)
	if not nf or maxShift < 0.05 then
		setMsg("Essa gravação já está reta para essa força — nada mudou. Aumente a força para alisar mais.", "info")
		return
	end
	local name = commitFrames(rec, nf, " (reta)")
	setMsg(string.format("Linhas retas aplicadas em «%s»: desvio máximo %.2f studs, percurso de %.0f para %.0f studs.%s", name, maxShift, before, after, settings.editCopy and " Salvo como cópia; a original continua igual." or " Se não gostou, use «Desfazer» na aba Regravar."), "ok")
end

local function undoEdit()
	if state ~= "idle" then
		busyMessage()
		return
	end
	local rec = selectedRec()
	if not rec then
		return
	end
	if not rec.undo then
		setMsg("Não há edição para desfazer nesta gravação.", "info")
		return
	end
	rec.frames, rec.duration = rec.undo.frames, rec.undo.duration
	rec.undo = nil
	rec.rows = nil
	rec.stats = nil
	rec.pts = nil
	edit.rec = nil
	renderList()
	markDirty(true)
	setMsg("Última edição desfeita: «" .. rec.name .. "» voltou ao que era antes.", "ok")
end

local function setEditValue(which, t)
	if state ~= "idle" then
		return
	end
	local rec = ensureEdit()
	if not rec then
		return
	end
	t = math.clamp(t, 0, rec.duration)
	if which == "a" then
		edit.a = t
		if edit.b < t then
			edit.b = t
		end
	else
		edit.b = t
		if edit.a > t then
			edit.a = t
		end
	end
	if refreshEdit then
		refreshEdit()
	end
end

-- marca A ou B no ponto do trajeto mais perto de onde o personagem está agora
local function markPoint(which)
	if state ~= "idle" then
		busyMessage()
		return
	end
	local rec = ensureEdit()
	if not rec then
		setMsg("Selecione uma gravação na lista da esquerda primeiro.", "warn")
		return
	end
	local _, _, root = getCharacter()
	if not root then
		setMsg("Seu personagem não está pronto.", "err")
		return
	end
	local frames = rec.frames
	local lo, hi = 1, #frames
	if which == "a" then
		hi = frameIndexAt(frames, edit.b) -- A não pode passar de B
	else
		lo = frameIndexAt(frames, edit.a) -- B não pode ficar antes de A
	end
	local best, bestD = lo, math.huge
	for i = lo, hi do
		local d = (frames[i].cf.Position - root.Position).Magnitude
		if d < bestD then
			best, bestD = i, d
		end
	end
	setEditValue(which, frames[best].t)
	setMsg(string.format("Ponto %s marcado em %.1fs (a %.1f studs de você).%s", string.upper(which), frames[best].t, bestD, bestD > 8 and " Você está longe do trajeto — confira o pilar no mundo." or ""), bestD > 8 and "warn" or "ok")
end

----------------------------------------------------------------------
-- FECHAR O SCRIPT (botão X): salva tudo e remove tudo
----------------------------------------------------------------------
local closeArmed, closeToken = false, 0

local function teardown()
	closed = true
	store.token += 1 -- cancela qualquer salvamento agendado
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(conns)
	if recConn then
		recConn:Disconnect()
		recConn = nil
	end
	clearPath()
	clearCutMarkers()
	clearDummyGuide()
	if marker then
		marker:Destroy()
		marker = nil
	end
	if ui.gui then
		ui.gui:Destroy()
	end
end

local function closeScript()
	if closed then
		return
	end
	if state == "playing" or state == "walking" or state == "countdown" then
		stopPlayback() -- para o que estiver rodando (devolve os controles ao personagem)
	elseif state ~= "idle" then
		setMsg("Não dá para fechar agora: termine a gravação, a janela de nome ou a de exportar primeiro. Nada foi perdido.", "warn")
		return
	end
	local saved
	if canFile then
		saved = saveNow(false) -- salva tudo antes de apagar, mesmo com o auto-salvar desligado
	else
		saved = (#recs == 0) -- sem arquivo não há onde guardar: só fecha direto se não houver nada a perder
	end
	if not saved and not closeArmed then
		closeArmed = true
		closeToken += 1
		local tok = closeToken
		ui.closeBtn.Text = "?"
		ui.closeBtn.BackgroundColor3 = C.yellow
		if canFile then
			setMsg("Não consegui salvar as gravações. Clique no X de novo para fechar mesmo assim.", "warn")
		else
			setMsg("Este ambiente não salva arquivos: ao fechar, as gravações somem. Use «Exportar todas» antes, ou clique no X de novo para fechar mesmo assim.", "warn")
		end
		task.delay(6, function()
			if closeArmed and tok == closeToken and not closed then
				closeArmed = false
				ui.closeBtn.Text = "X"
				ui.closeBtn.BackgroundColor3 = C.red
			end
		end)
		return
	end
	teardown()
end

