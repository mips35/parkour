	end
	local wasRename = (ui.nameMode == "rename")
	pending = nil
	closeNameDialog()
	state = "idle"
	setStatus("Pronto", C.green)
	setMsg(wasRename and "Renomeação cancelada." or "Gravação descartada.", "info")
