local marker = nil

local function updateMarker()
	if marker then
		marker:Destroy()
		marker = nil
	end
	if not settings.marker or not enabled then
		return
	end
	local rec = selected and recs[selected]
	if not rec then
		return
	end
	local startPos = rec.frames[1].cf.Position
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local hit = workspace:Raycast(startPos, Vector3.new(0, -12, 0), params)
	local pos = hit and (hit.Position + Vector3.new(0, 0.08, 0)) or (startPos - Vector3.new(0, 3, 0))
	marker = make("Part", {
		Name = "PontoInicialGravador",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 4, 4),
		Material = Enum.Material.Neon,
		Color = C.green,
		Transparency = 0.45,
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
	}, workspace)
end

