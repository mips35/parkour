local pathFolder = nil

-- ===== análise do trajeto e «linhas mais retas» =====
local geo = {}

-- distância de um ponto ao segmento (no plano horizontal XZ)
function geo.segDist(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	if l2 < 1e-9 then
		return math.sqrt((px - ax) ^ 2 + (pz - az) ^ 2)
	end
	local t = math.clamp(((px - ax) * dx + (pz - az) * dz) / l2, 0, 1)
	return math.sqrt((px - (ax + t * dx)) ^ 2 + (pz - (az + t * dz)) ^ 2)
end

-- Ramer–Douglas–Peucker (iterativo): índices dos vértices que precisam ficar para a linha não se desviar mais que tol
function geo.rdp(xs, zs, a, b, tol)
	local keep = { [a] = true, [b] = true }
	local stack = { { a, b } }
	while #stack > 0 do
		local seg = table.remove(stack)
		local i0, i1 = seg[1], seg[2]
		local maxD, idx = 0, nil
		for i = i0 + 1, i1 - 1 do
			local d = geo.segDist(xs[i], zs[i], xs[i0], zs[i0], xs[i1], zs[i1])
			if d > maxD then
				maxD, idx = d, i
			end
		end
		if idx and maxD > tol then
			keep[idx] = true
			stack[#stack + 1] = { i0, idx }
			stack[#stack + 1] = { idx, i1 }
		end
	end
	local out = {}
	for i = a, b do
		if keep[i] then
			out[#out + 1] = i
		end
	end
	return out
end

-- Deixa o trajeto no chão mais reto: tira o «tremido» lateral do andar mantendo as curvas de verdade,
-- a altura, os tempos e tudo que é pulo/queda (esses trechos ficam intactos, com 0,2s de margem).
-- Devolve: novos frames, desvio máximo (studs), comprimento antes e depois.
-- dry = true: só calcula os números, sem montar os frames.
local function straightenFrames(frames, tol, dry)
	local n = #frames
	if n < 3 then
		return frames, 0, 0, 0
	end
	local orig, air = table.create(n, false), table.create(n, false)
	for i, f in ipairs(frames) do
		if f.j or math.abs(f.v.Y) > 3 then
			orig[i] = true
			air[i] = true
		end
	end
	local lastT = -math.huge
	for i = 1, n do
		if orig[i] then
			lastT = frames[i].t
		elseif frames[i].t - lastT <= 0.2 then
			air[i] = true
		end
	end
	local nextT = math.huge
	for i = n, 1, -1 do
		if orig[i] then
			nextT = frames[i].t
		elseif nextT - frames[i].t <= 0.2 then
			air[i] = true
		end
	end

	local xs, zs = table.create(n, 0), table.create(n, 0)
	for i, f in ipairs(frames) do
		local p = f.cf.Position
		xs[i], zs[i] = p.X, p.Z
	end
	local nx, nz = table.clone(xs), table.clone(zs)
	local moved = table.create(n, false)
	local maxShift, lenBefore, lenAfter = 0, 0, 0

	local i = 1
	while i <= n do
		if air[i] then
			i += 1
		else
			local a = i
			while i < n and not air[i + 1] do
				i += 1
			end
			local b = i
			i += 1
			if b - a >= 2 then
				local kept = geo.rdp(xs, zs, a, b, tol)
				for k = 1, #kept - 1 do
					local i0, i1 = kept[k], kept[k + 1]
					local ax, az, bx, bz = xs[i0], zs[i0], xs[i1], zs[i1]
					local dx, dz = bx - ax, bz - az
					local l2 = dx * dx + dz * dz
					local tPrev = 0
					for j = i0, i1 do
						local t = 0
						if l2 > 1e-9 then
							t = math.clamp(((xs[j] - ax) * dx + (zs[j] - az) * dz) / l2, 0, 1)
						end
						if t < tPrev then
							t = tPrev -- nunca volta atrás na linha
						end
						tPrev = t
						nx[j], nz[j] = ax + t * dx, az + t * dz
						moved[j] = true
					end
					lenAfter += math.sqrt(l2)
				end
				for j = a + 1, b do
					lenBefore += math.sqrt((xs[j] - xs[j - 1]) ^ 2 + (zs[j] - zs[j - 1]) ^ 2)
					local sh = math.sqrt((nx[j] - xs[j]) ^ 2 + (nz[j] - zs[j]) ^ 2)
					if sh > maxShift then
						maxShift = sh
					end
				end
			end
		end
	end
	if dry then
		return nil, maxShift, lenBefore, lenAfter
	end

	local out = table.create(n)
	for j, f in ipairs(frames) do
		if moved[j] and (nx[j] ~= xs[j] or nz[j] ~= zs[j]) then
			local p = f.cf.Position
			local m, v = f.m, f.v
			-- a direção do movimento acompanha a linha nova (vale também para o modo Natural)
			local tx, tz
			if j < n and moved[j + 1] then
				tx, tz = nx[j + 1] - nx[j], nz[j + 1] - nz[j]
			elseif j > 1 and moved[j - 1] then
				tx, tz = nx[j] - nx[j - 1], nz[j] - nz[j - 1]
			end
			if tx then
				local tl = math.sqrt(tx * tx + tz * tz)
				if tl > 1e-4 then
					local ux, uz = tx / tl, tz / tl
					local mm = math.sqrt(m.X * m.X + m.Z * m.Z)
					if mm > 0.1 then
						m = Vector3.new(ux * mm, m.Y, uz * mm)
					end
					local sp = math.sqrt(v.X * v.X + v.Z * v.Z)
					if sp > 0.1 then
						v = Vector3.new(ux * sp, v.Y, uz * sp)
					end
				end
			end
			out[j] = { t = f.t, cf = CFrame.new(nx[j], p.Y, nz[j]) * f.cf.Rotation, v = v, m = m, j = f.j, s = f.s, k = f.k }
		else
			out[j] = f
		end
	end
	return out, maxShift, lenBefore, lenAfter
end

-- números da gravação (calculados uma vez e guardados)
local function getStats(rec)
	if not rec.stats then
		local len, jumps, maxSp = 0, 0, 0
		local fr = rec.frames
		for i, f in ipairs(fr) do
			local sp = math.sqrt(f.v.X * f.v.X + f.v.Z * f.v.Z)
			if sp > maxSp then
				maxSp = sp
			end
			if i > 1 then
				len += (f.cf.Position - fr[i - 1].cf.Position).Magnitude
				if f.j and not fr[i - 1].j then
					jumps += 1
				end
			end
		end
		local _, _, before, after = straightenFrames(fr, 0.6, true)
		rec.stats = {
			length = len,
			jumps = jumps,
			maxSpeed = maxSp,
			avgSpeed = (rec.duration > 0) and (len / rec.duration) or 0,
			straight = (before > 0.01) and math.min(1, after / before) or 1, -- 1 = sem tremido
		}
	end
	return rec.stats
end
-- posições de todos os frames (em cache) e o frame mais próximo de uma posição
local function getPts(rec)
	if not rec.pts then
		local pts = table.create(#rec.frames)
		for i, f in ipairs(rec.frames) do
			pts[i] = f.cf.Position
		end
		rec.pts = pts
	end
	return rec.pts
end

local function nearestIndex(pts, pos)
	local best, bestD = 1, math.huge
	for i = 1, #pts do
		local d = (pts[i] - pos).Magnitude
		if d < bestD then
			best, bestD = i, d
		end
	end
	return best, bestD
end

local function clearPath()
	if pathFolder then
		pathFolder:Destroy()
		pathFolder = nil
	end
end

-- distância do centro do personagem até os pés (o traço é desenhado no chão)
local function footOffset()
	local _, hum, root = getCharacter()
	if hum and root and hum.RigType == Enum.HumanoidRigType.R15 then
		return hum.HipHeight + root.Size.Y / 2
	end
	return 3
end

local function newPathPart(props)
	props.Anchored = true
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	props.CastShadow = false
	props.Material = Enum.Material.Neon
	return make("Part", props, pathFolder)
end

