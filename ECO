-- índice do frame mais próximo do tempo t
local function frameIndexAt(frames, t)
	local lo, hi = 1, #frames
	while lo < hi do
		local mid = (lo + hi) // 2
		if frames[mid].t < t then
			lo = mid + 1
		else
			hi = mid
		end
	end
	if lo > 1 and (t - frames[lo - 1].t) < (frames[lo].t - t) then
		lo -= 1
	end
	return lo
end

-- garante que A e B pertencem à gravação selecionada e estão em ordem
local function ensureEdit()
	local rec = selected and recs[selected]
	if not rec then
		edit.rec = nil
		return nil
	end
	if edit.rec ~= rec then
		edit.rec = rec
		edit.a = rec.duration / 2
		edit.b = rec.duration
	end
	edit.a = math.clamp(edit.a, 0, rec.duration)
	edit.b = math.clamp(edit.b, edit.a, rec.duration)
	return rec, edit
end

