local function openIO(mode)
	if state ~= "idle" then
		busyMessage()
		return
	end
	if mode == "export" then
		if #recs == 0 then
			setMsg("Não há gravações para exportar ainda.", "warn")
			return
		end
		ui.ioAll = not (selected and recs[selected])
	end
	state = "io"
	ui.ioMode = mode
	if mode == "export" then
		ui.ioHelp.Text = "Clique em «Selecionar tudo», copie com Ctrl+C e guarde o texto (num bloco de notas, por exemplo). Para recuperar, use «Importar» e cole o texto."
		ui.ioAction.Text = "🔎  Selecionar tudo"
		ui.ioAction.BackgroundColor3 = C.blue
		ui.ioToggle.Visible = true
		fillExport()
	else
		ui.ioTitle.Text = "📥 Importar gravação(ões)"
		ui.ioHelp.Text = "Cole abaixo o texto exportado antes (uma gravação ou todas) e clique em «Importar»."
		ui.ioBox.Text = ""
		ui.ioAction.Text = "📥  Importar"
		ui.ioAction.BackgroundColor3 = C.green
		ui.ioToggle.Visible = false
	end
	ui.ioOverlay.Visible = true
end

local function runIOAction()
	if ui.ioMode == "export" then
		ui.ioBox:CaptureFocus()
		task.defer(function()
			ui.ioBox.SelectionStart = 1
			ui.ioBox.CursorPosition = #ui.ioBox.Text + 1
		end)
		return
	end
	local okJ, data = pcall(function()
		return HttpService:JSONDecode(ui.ioBox.Text)
	end)
	if not okJ or type(data) ~= "table" then
		setMsg("Esse texto não é uma gravação válida. Cole o texto completo, exatamente como foi exportado.", "err")
		return
	end
	local list, failed = {}, 0
	if type(data.recs) == "table" then
		for i, d in ipairs(data.recs) do
			local ok, rec = pcall(decodeRecTable, d, "Importada " .. i)
			if ok and rec then
				list[#list + 1] = rec
			else
				failed += 1
			end
		end
	else
		local ok, rec = pcall(decodeRecTable, data, "Importada")
		if ok and rec then
			list[1] = rec
		else
			failed += 1
		end
	end
	if #list == 0 then
		setMsg("Esse texto não é uma gravação válida. Cole o texto completo, exatamente como foi exportado.", "err")
		return
	end
	for _, rec in ipairs(list) do
		rec.name = uniqueName(string.sub(rec.name, 1, MAX_NOME))
		table.insert(recs, rec)
	end
	selected = #recs
	edit.rec = nil
	closeIO()
	renderList()
	markDirty(true)
	setStatus("Pronto", C.green)
	local extra = (failed > 0) and (" (" .. failed .. " não puderam ser lidas)") or ""
	if #list == 1 then
		setMsg("Gravação «" .. list[1].name .. "» importada e selecionada!" .. extra, "ok")
	else
		setMsg(#list .. " gravações importadas!" .. extra, "ok")
	end
end

