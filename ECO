----------------------------------------------------------------------
-- ATALHOS DE TECLADO
----------------------------------------------------------------------
onGlobal(UserInputService.InputBegan, function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return -- mouse (inclusive botão direito) e toque nunca disparam atalhos
	end
	if rebindingId then
		handleRebind(input)
		return
	end
	if gameProcessed then
		return -- está digitando em alguma caixa de texto
	end
	for _, a in ipairs(ACTIONS) do
		if binds[a.id] == input.KeyCode then
			-- sistema desligado: nenhum atalho funciona (menos a tecla de minimizar/mostrar quando o
			-- botãozinho está escondido — senão você ficaria sem como abrir o painel)
			if enabled or (a.id == "toggle" and settings.hideMini) then
				a.fn()
			end
			return
		end
	end
end)

----------------------------------------------------------------------
-- MEDIDORES AO VIVO + PONTOS A/B NO MUNDO + ANIMAÇÃO DO BONECO-GUIA
----------------------------------------------------------------------
local infoAcc = 0
local dummyAcc = 0
-- anima o boneco-guia (~30x por segundo — não precisa ser todo frame pra ficar suave)
onGlobal(RunService.Heartbeat, function(dt)
	if #dummies == 0 then
		return
	end
	-- otimização: a pose do boneco-guia só precisa atualizar ~30x por segundo (não todo frame) para continuar suave
	dummyAcc += dt or (1 / 60)
	if dummyAcc < 1 / 30 then
		return
	end
	dummyAcc = 0
	if not enabled or not settings.path or settings.guideMode ~= "dummy" or dummiesRec ~= (selected and recs[selected]) or (ui.tab == "edit" and recTarget) then
		clearDummyGuide()
		return
	end
	local dur = math.max(dummiesRec.duration, 0.05)
	local now = os.clock()
	for _, d in ipairs(dummies) do
		local okP = pcall(poseDummy, d, (now - d.phase) % dur)
		if not okP then
			clearDummyGuide()
			break
		end
	end
end)

onGlobal(RunService.Heartbeat, function(dt)
	infoAcc += dt
	if infoAcc < 0.1 then
		return
	end
	infoAcc = 0
	if ui.cutDirty then
		ui.cutDirty = false
		pcall(updateCutMarkers)
	end
	if ui.main.Visible then
		pcall(updateSummary)
		if ui.tab == "play" then
			pcall(updateInfo)
		elseif ui.tab == "edit" then
			pcall(updateEditInfo)
		elseif ui.tab == "analysis" then
			if ui.anaDirty then
				ui.anaDirty = false
				pcall(ui.drawAnalysis)
			end
			pcall(ui.updateAnalysisInfo)
			pcall(ui.updateAnalysisLive)
		end
	end
end)

----------------------------------------------------------------------
-- CARREGAR DO ARQUIVO + SALVAR AO SAIR
----------------------------------------------------------------------
local function loadFromDisk()
	if not canFile then
		setMsg("Bem-vindo! Atenção: este ambiente não permite criar arquivos, então as gravações NÃO ficam salvas ao sair. Use «Exportar» → «Exportar todas» para guardá-las.", "warn")
		return
	end
	local exists = true
	if type(isfile) == "function" then
		local okE, res = pcall(isfile, FILE)
		exists = okE and res
	end
	if not exists then
		setMsg("Bem-vindo! Suas gravações serão salvas sozinhas num arquivo local. Comece pela aba «Gravar».", "info")
		return
	end
	local okR, raw = pcall(readfile, FILE)
	if not okR or type(raw) ~= "string" or raw == "" then
		setMsg("Bem-vindo! Não consegui ler o arquivo de salvamento; começando do zero.", "warn")
		return
	end
	local okJ, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not okJ or type(data) ~= "table" then
		pcall(writefile, FILE .. ".bak", raw) -- guarda uma cópia antes de qualquer novo salvamento
		setMsg("O arquivo de salvamento estava corrompido; guardei uma cópia (.bak) e comecei do zero.", "err")
		return
	end

	store.loading = true
	state = "loading"
	setStatus("Carregando…", C.teal)
	setMsg("Carregando suas gravações salvas…", "info")

	local cfg = data.cfg
	if type(cfg) == "table" then
		if cfg.mode == "tp" or cfg.mode == "nat" then
			settings.mode = cfg.mode
		end
		if type(cfg.tolerance) == "number" then
			settings.tolerance = math.clamp(cfg.tolerance, 0.5, 10)
		end
		if type(cfg.straightTol) == "number" then
			settings.straightTol = math.clamp(cfg.straightTol, 0.2, 3)
		end
		if cfg.guideMode == "line" or cfg.guideMode == "dummy" then
			settings.guideMode = cfg.guideMode
		end
		if type(cfg.dummyInterval) == "number" then
			settings.dummyInterval = math.clamp(cfg.dummyInterval, 0.5, 10)
		end
		for _, k in ipairs({ "marker", "path", "autosave", "stopAtCut", "editCopy", "editFree", "hideMini", "straighten", "walkGoto" }) do
			if type(cfg[k]) == "boolean" then
				settings[k] = cfg[k]
			end
		end
		if type(cfg.binds) == "table" then
			local newBinds = {}
			for id, nm in pairs(cfg.binds) do
				if ACTION_BY_ID[id] and type(nm) == "string" then
					local okK, kc = pcall(function()
						return Enum.KeyCode[nm]
					end)
					if okK and kc and kc ~= Enum.KeyCode.Unknown and not BLOCKED_KEYS[kc] then
						newBinds[id] = kc
					end
				end
			end
			local seen, valid = {}, true
			for _, a in ipairs(ACTIONS) do
				local kc = newBinds[a.id] or binds[a.id]
				if seen[kc] then
					valid = false
					break
				end
				seen[kc] = true
			end
			if valid then
				for id, kc in pairs(newBinds) do
					binds[id] = kc
				end
			end
		end
	end

	local loaded, failed = 0, 0
	if type(data.recs) == "table" then
		for i, d in ipairs(data.recs) do
			local ok, rec = pcall(decodeRecTable, d, "Gravação " .. i, 600)
			if ok and rec then
				recs[#recs + 1] = rec
				loaded += 1
			else
				failed += 1
			end
			task.wait()
		end
	end
	if type(cfg) == "table" and type(cfg.selected) == "string" then
		for i, r in ipairs(recs) do
			if r.name == cfg.selected then
				selected = i
			end
		end
	end

	store.loading = false
	store.dirty = false
	state = "idle"
	setStatus("Pronto", C.green)
	refreshKeys()
	refreshHelp()
	refreshSettings()
	refreshStoreInfo()
	renderList()
	local extra = (failed > 0) and (" (" .. failed .. " não puderam ser lidas)") or ""
	if loaded > 0 then
		setMsg(string.format("%d gravação(ões) carregadas do arquivo!%s Selecione uma na lista.", loaded, extra), "ok")
	else
		setMsg("Bem-vindo! Comece pela aba «Gravar». Clique no botão «TECLA» de qualquer ação para trocar o atalho." .. extra, "info")
	end
end

local function flushOnExit()
	if not closed and store.dirty and canFile and settings.autosave and not store.loading then
		pcall(saveNow, false)
	end
end
onGlobal(Players.PlayerRemoving, function(p)
	if p == player then
		flushOnExit()
	end
end)
onGlobal(player.AncestryChanged, function(_, parent)
	if not parent then
		flushOnExit()
	end
end)
gui.Destroying:Connect(flushOnExit)
pcall(function()
	game:BindToClose(flushOnExit)
end)

-- rede de segurança: a cada 20s, tenta salvar o que ficou pendente
task.spawn(function()
	while gui.Parent and not closed do
		task.wait(20)
		if not closed and store.dirty and canFile and settings.autosave and not store.loading and state ~= "recording" then
			saveNow(false)
		end
	end
end)

