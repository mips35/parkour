-- Arrastar (e, se não arrastou, tratar como clique).
-- Só reage ao toque/clique ESQUERDO que COMEÇOU neste botão: o botão direito e cliques em
-- qualquer outro lugar da tela são ignorados (era isso que reabria o menu sozinho).
local function makeDraggable(handle, target, scaleObj, onClick)
	local active, activeType = nil, nil
	local moved = false
	local dragStart, startPos = Vector2.zero, target.Position

	handle.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if active == nil and (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) then
			active, activeType, moved = input, t, false
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = target.Position
		end
	end)

	onGlobal(UserInputService.InputChanged, function(input)
		if not active then
			return
		end
		local t = input.UserInputType
		local isMove = (activeType == Enum.UserInputType.MouseButton1 and t == Enum.UserInputType.MouseMovement)
			or (activeType == Enum.UserInputType.Touch and t == Enum.UserInputType.Touch)
		if not isMove then
			return
		end
		local d = Vector2.new(input.Position.X, input.Position.Y) - dragStart
		if d.Magnitude > 5 then
			moved = true
		end
		if moved then
			local s = scaleObj and scaleObj.Scale or 1
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X / s, startPos.Y.Scale, startPos.Y.Offset + d.Y / s)
		end
	end)

	onGlobal(UserInputService.InputEnded, function(input)
		if not active or input.UserInputType ~= activeType then
			return
		end
		local wasClick = not moved
		active = nil -- zera sempre: nada fica "armado" para o próximo clique
		if wasClick and onClick then
			onClick()
		end
	end)
end

