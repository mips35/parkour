local dummies = {} -- rastro de bonecos-guia: vários, espaçados no tempo ({ rec, phase, model, torso, head, legL, legR, armL, armR })
local dummiesRec = nil -- gravação para a qual "dummies" foi montado

local MAX_DUMMIES = 15 -- limite de segurança (gravações longas com intervalo curto não geram bonecos demais)

local function clearDummyGuide()
	for _, d in ipairs(dummies) do
		d.model:Destroy()
	end
	table.clear(dummies)
	dummiesRec = nil
end

local function dummyCount(rec)
	return math.clamp(math.ceil(rec.duration / math.max(settings.dummyInterval, 0.1)), 1, MAX_DUMMIES)
end

local function buildDummyGuide(rec)
	local count = dummyCount(rec)
	if dummiesRec == rec and #dummies == count then
		return -- já existe, do jeito certo, para esta gravação
	end
	clearDummyGuide()
	dummiesRec = rec
	for i = 1, count do
		local model = make("Model", { Name = "BonecoGuiaGravador" .. i }, workspace)
		local function limb(name, size)
			return make("Part", {
				Name = name,
				Size = size,
				Color = C.blueDark,
				Material = Enum.Material.ForceField,
				Transparency = 0.1,
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
			}, model)
		end
		local d = {
			rec = rec,
			phase = (i - 1) * settings.dummyInterval, -- este boneco fica "atrasado" em relação ao primeiro
			model = model,
			torso = limb("Torso", Vector3.new(2, 2, 1)),
			head = limb("Cabeça", Vector3.new(1.2, 1.2, 1.2)),
			legL = limb("PernaEsquerda", Vector3.new(0.7, 2, 0.7)),
			legR = limb("PernaDireita", Vector3.new(0.7, 2, 0.7)),
			armL = limb("BraçoEsquerdo", Vector3.new(0.6, 1.8, 0.6)),
			armR = limb("BraçoDireito", Vector3.new(0.6, 1.8, 0.6)),
		}
		d.torso.Color = C.blue
		d.head.Color = C.blue
		dummies[#dummies + 1] = d
	end
end

-- índice do último frame com tempo <= t (para interpolar com o próximo)
local function floorFrame(frames, t)
	local lo, hi = 1, #frames
	while lo < hi do
		local mid = (lo + hi + 1) // 2
		if frames[mid].t <= t then
			lo = mid
		else
			hi = mid - 1
		end
	end
	return lo
end

-- pose (CFrame, velocidade, se está no ar) no instante t de uma gravação, interpolada entre dois frames
local function sampleAt(frames, t)
	local i = floorFrame(frames, t)
	local a, b = frames[i], frames[i + 1]
	if not b then
		return a.cf, a.v, a.j
	end
	local alpha = math.clamp((t - a.t) / math.max(b.t - a.t, 1e-6), 0, 1)
	return a.cf:Lerp(b.cf, alpha), a.v:Lerp(b.v, alpha), (alpha > 0.5) and b.j or a.j
end

-- posiciona o boneco-guia no instante t do loop (braços e pernas balançam de acordo com a velocidade)
local function poseDummy(d, t)
	local cf, v, air = sampleAt(d.rec.frames, t)
	local sp = math.sqrt(v.X * v.X + v.Z * v.Z)
	local amp = math.clamp(sp / 16, 0, 1)
	local swing = math.sin(t * (5 + amp * 5)) * amp * 0.7
	d.torso.CFrame = cf
	d.head.CFrame = cf * CFrame.new(0, 1.7, 0)
	if air then
		d.legL.CFrame = cf * CFrame.new(-0.55, -1, 0.3) * CFrame.Angles(-0.8, 0, 0) * CFrame.new(0, -1, 0)
		d.legR.CFrame = cf * CFrame.new(0.55, -1, 0.3) * CFrame.Angles(-0.8, 0, 0) * CFrame.new(0, -1, 0)
		d.armL.CFrame = cf * CFrame.new(-1.35, 0.9, 0) * CFrame.Angles(-0.4, 0, 0) * CFrame.new(0, -0.9, 0)
		d.armR.CFrame = cf * CFrame.new(1.35, 0.9, 0) * CFrame.Angles(-0.4, 0, 0) * CFrame.new(0, -0.9, 0)
	else
		d.legL.CFrame = cf * CFrame.new(-0.55, -1, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -1, 0)
		d.legR.CFrame = cf * CFrame.new(0.55, -1, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -1, 0)
		d.armL.CFrame = cf * CFrame.new(-1.35, 0.9, 0) * CFrame.Angles(-swing, 0, 0) * CFrame.new(0, -0.9, 0)
		d.armR.CFrame = cf * CFrame.new(1.35, 0.9, 0) * CFrame.Angles(swing, 0, 0) * CFrame.new(0, -0.9, 0)
	end
end
local function updatePath()
	clearPath()
	if not settings.path or not enabled then
		clearDummyGuide()
		return
	end
	local rec = selected and recs[selected]
	if not rec then
		clearDummyGuide()
		return
	end
	if settings.guideMode == "dummy" then
		buildDummyGuide(rec)
		return
	end
	clearDummyGuide()
	local frames = rec.frames
	local down = Vector3.new(0, footOffset(), 0)
	local step = math.max(0.6, getStats(rec).length / 350) -- no máximo ~350 trechos

	local pts, jumps = { frames[1].cf.Position - down }, {}
	local last = pts[1]
	for i = 2, #frames do
		local p = frames[i].cf.Position - down
		if frames[i].j and not frames[i - 1].j then
			jumps[#jumps + 1] = p
		end
		if (p - last).Magnitude >= step or i == #frames then
			pts[#pts + 1] = p
			last = p
		end
	end

	pathFolder = make("Folder", { Name = "TrajetoGravador" }, workspace)
	local segs = #pts - 1
	for k = 1, segs do
		local a, b = pts[k], pts[k + 1]
		local len = (b - a).Magnitude
		if len > 0.01 then
			newPathPart({
				Name = "Trecho",
				Size = Vector3.new(0.2, 0.2, len),
				Color = Color3.fromHSV(0.36 * (1 - k / segs), 0.85, 1), -- verde → amarelo → vermelho
				Transparency = 0.2,
				CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2),
			})
		end
	end
	for _, p in ipairs(jumps) do
		newPathPart({
			Name = "Pulo",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.9, 0.9),
			Color = C.yellow,
			Transparency = 0.1,
			CFrame = CFrame.new(p),
		})
	end
	newPathPart({
		Name = "Fim",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.4, 1.4, 1.4),
		Color = C.red,
		Transparency = 0.1,
		CFrame = CFrame.new(pts[#pts]),
	})
end

