----------------------------------------------------------------------
local function rnd(n, p)
	return math.round(n * p) / p
end

local function encodeRows(frames)
	local rows = table.create(#frames)
	local keys, keyIdx = {}, {}
	for i, f in ipairs(frames) do
		local row = { rnd(f.t, 10000) }
		local comps = { f.cf:GetComponents() }
		for k = 1, 12 do
			row[#row + 1] = rnd(comps[k], k <= 3 and 10000 or 100000)
		end
		row[#row + 1] = rnd(f.v.X, 1000)
		row[#row + 1] = rnd(f.v.Y, 1000)
		row[#row + 1] = rnd(f.v.Z, 1000)
		row[#row + 1] = rnd(f.m.X, 1000)
		row[#row + 1] = rnd(f.m.Y, 1000)
		row[#row + 1] = rnd(f.m.Z, 1000)
		row[#row + 1] = f.j and 1 or 0
		-- ritmo da animação de andar (velocidade da animação) e qual animação era; 0 = não registrado
		local ki = 0
		if f.s and f.k then
			ki = keyIdx[f.k]
			if not ki then
				keys[#keys + 1] = f.k
				ki = #keys
				keyIdx[f.k] = ki
			end
		end
		row[#row + 1] = f.s and rnd(f.s, 1000) or 0
		row[#row + 1] = ki
		rows[i] = row
	end
	return rows, keys
end
-- JSON de uma gravação (as linhas ficam em cache: só são recodificadas quando a gravação muda)
local function recJSON(rec)
	if not rec.rows then
		local rows, keys = encodeRows(rec.frames)
		rec.rows = HttpService:JSONEncode(rows)
		rec.rowKeys = HttpService:JSONEncode(keys)
	end
	local nameJson = string.sub(HttpService:JSONEncode({ rec.name }), 2, -2)
	return '{"n":' .. nameJson .. ',"d":' .. tostring(rnd(rec.duration, 10000)) .. ',"f":' .. rec.rows .. ',"k":' .. (rec.rowKeys or "[]") .. "}"
end

local function encodeAll()
	local parts = {}
	for i, r in ipairs(recs) do
		parts[i] = recJSON(r)
	end
	return '{"gravador":2,"recs":[' .. table.concat(parts, ",") .. "]}"
end

local function decodeRecTable(data, fallbackName, yieldEvery)
	assert(type(data) == "table" and type(data.f) == "table" and #data.f >= 2, "formato inválido")
	local frames = table.create(#data.f)
	local keys = (type(data.k) == "table") and data.k or {}
	for i, row in ipairs(data.f) do
		assert(type(row) == "table" and (#row == 20 or #row == 22), "linha inválida")
		for k = 1, #row do
			assert(type(row[k]) == "number", "valor inválido")
		end
		frames[i] = {
			t = row[1],
			cf = CFrame.new(table.unpack(row, 2, 13)),
			v = Vector3.new(row[14], row[15], row[16]),
			m = Vector3.new(row[17], row[18], row[19]),
			j = row[20] == 1,
		}
		if #row == 22 and row[22] > 0 and type(keys[row[22]]) == "string" then
			frames[i].s = row[21]
			frames[i].k = keys[row[22]]
		end
		if yieldEvery and i % yieldEvery == 0 then
			task.wait()
		end
	end
	return {
		name = tostring(data.n or fallbackName or "Importada"),
		frames = frames,
		duration = tonumber(data.d) or frames[#frames].t,
	}
end

local function uniqueName(name, except)
	local function exists(nm)
		for _, r in ipairs(recs) do
			if r ~= except and r.name == nm then
				return true
			end
		end
		return false
	end
	local base, n = name, 2
	while exists(name) do
		name = base .. " (" .. n .. ")"
		n += 1
	end
	return name
end

