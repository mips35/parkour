		local cosEl = math.cos(o.el)
		local dir = Vector3.new(math.cos(o.az) * cosEl, math.sin(o.el), math.sin(o.az) * cosEl)
		ui.mapCam.CFrame = CFrame.lookAt(o.center + dir * o.dist, o.center)
	end

	local function zoomBy(mult)
		ui.orbit.dist = math.clamp(ui.orbit.dist * mult, 3, 400)
		applyCamera()
	end

	local dragging, dragType, lastX, lastY = false, nil, 0, 0
	ui.mapView.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging, dragType = true, t
			lastX, lastY = input.Position.X, input.Position.Y
		end
	end)
	ui.mapView.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			zoomBy(1 - input.Position.Z * 0.12)
		end
	end)
	onGlobal(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		local t = input.UserInputType
		if (dragType == Enum.UserInputType.MouseButton1 and t == Enum.UserInputType.MouseMovement) or (dragType == Enum.UserInputType.Touch and t == Enum.UserInputType.Touch) then
			local dx, dy = input.Position.X - lastX, input.Position.Y - lastY
			lastX, lastY = input.Position.X, input.Position.Y
			ui.orbit.az -= dx * 0.012
			ui.orbit.el = math.clamp(ui.orbit.el + dy * 0.012, -1.4, 1.4)
			applyCamera()
		end
	end)
	onGlobal(UserInputService.InputEnded, function(input)
		if dragging and input.UserInputType == dragType then
			dragging = false
		end
	end)
	zoomIn.MouseButton1Click:Connect(function()
		zoomBy(0.8)
	end)
	zoomOut.MouseButton1Click:Connect(function()
		zoomBy(1.25)
	end)
	resetBtn.MouseButton1Click:Connect(function()
		ui.orbit.az, ui.orbit.el = DEFAULT_AZ, DEFAULT_EL
		applyCamera()
	end)

	local function line3D(a, b, color, thick)
		local len = (b - a).Magnitude
		if len < 0.05 then
			return
		end
		make("Part", {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.Neon,
			Color = color,
			Size = Vector3.new(thick, thick, len),
			CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2),
		}, ui.mapParts)
	end

	local function dot3D(pos, size, color)
		return make("Part", {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.Neon,
			Color = color,
			Size = Vector3.new(size, size, size),
			CFrame = CFrame.new(pos),
		}, ui.mapParts)
	end

	-- redesenha o mapa 3D e o gráfico da gravação selecionada
	ui.drawAnalysis = function()
		for _, c in ipairs(ui.mapParts:GetChildren()) do
			c:Destroy()
		end
		for _, c in ipairs(ui.graphFrame:GetChildren()) do
			if c:IsA("GuiObject") then
				c:Destroy()
			end
		end
		ui.mapPlayerPart = nil
		local rec = selected and recs[selected]
		ui.mapHint.Visible = (rec == nil)
		if not rec then
			ui.graphCaption.Text = ""
			return
		end
		local frames = rec.frames
		local old = rec.undo and rec.undo.frames or nil

		local minP, maxP = frames[1].cf.Position, frames[1].cf.Position
		local function grow(list)
			for _, f in ipairs(list) do
				local p = f.cf.Position
				minP = Vector3.new(math.min(minP.X, p.X), math.min(minP.Y, p.Y), math.min(minP.Z, p.Z))
				maxP = Vector3.new(math.max(maxP.X, p.X), math.max(maxP.Y, p.Y), math.max(maxP.Z, p.Z))
			end
		end
		grow(frames)
		if old then
			grow(old)
		end
		local center = (minP + maxP) * 0.5
		local radius = math.max((maxP - minP).Magnitude / 2, 2)
		if rec ~= lastMapRec then
			ui.orbit.az, ui.orbit.el = DEFAULT_AZ, DEFAULT_EL
			ui.orbit.dist = radius * 2.4
			lastMapRec = rec
		end
		ui.orbit.center = center
		applyCamera()

		local function polyline(list, colorAt, thick)
			local n = #list
			local step = math.max(1, n // 220)
			local total = math.max(1, (n - 1) // step)
			local prev
			local k = 0
			local function add(i)
				local pos = list[i].cf.Position
				if prev then
					line3D(prev, pos, colorAt(math.min(k / total, 1)), thick)
				end
				prev = pos
				k += 1
			end
			for i = 1, n, step do
				add(i)
			end
			if (n - 1) % step ~= 0 then
				add(n)
			end
		end
		if old then
			polyline(old, function()
				return Color3.fromRGB(105, 112, 138)
			end, 0.25)
		end
		polyline(frames, function(f)
			return Color3.fromHSV(0.36 * (1 - f), 0.85, 1) -- verde → amarelo → vermelho, como no mundo
		end, 0.4)
		for i = 2, #frames do
			if frames[i].j and not frames[i - 1].j then
				dot3D(frames[i].cf.Position, 1, C.yellow)
			end
		end
		dot3D(frames[1].cf.Position, 1.4, C.green)
		dot3D(frames[#frames].cf.Position, 1.4, C.red)
		ui.mapPlayerPart = dot3D(frames[1].cf.Position, 1.1, C.white)

		-- gráfico de velocidade (barras amarelas = momentos com pulo) — continua em 2D: é uma linha do tempo
		local st = getStats(rec)
		local bars = 120
		local dur = math.max(rec.duration, 0.1)
		local maxV = math.max(20, st.maxSpeed)
		local bw = MAP_W / bars
		local fi = 1
		for b = 1, bars do
			local t1 = b / bars * dur
			local peak, jumped = 0, false
			while fi <= #frames and frames[fi].t < t1 do
				local f = frames[fi]
				local sp = math.sqrt(f.v.X * f.v.X + f.v.Z * f.v.Z)
				if sp > peak then
					peak = sp
				end
				if f.j then
					jumped = true
				end
				fi += 1
			end
			local h = math.clamp(peak / maxV, 0, 1) * (GRAPH_H - 6)
			if h >= 1 then
				make("Frame", {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.fromOffset((b - 1) * bw, GRAPH_H - 2),
					Size = UDim2.fromOffset(math.max(bw - 1, 1), h),
					BackgroundColor3 = jumped and C.yellow or C.blue,
				}, ui.graphFrame)
			end
		end
		ui.graphCaption.Text = string.format("0s → %.1fs   •   amarelo = pulo   •   altura = velocidade (máx. %.0f studs/s)", rec.duration, maxV)
	end

	-- textos da análise (atualizados ao vivo)
	ui.updateAnalysisInfo = function()
		local rec = selected and recs[selected]
		if not rec then
			ui.anaInfo.Text = '<font color="rgb(245,190,70)">Nenhuma gravação selecionada.</font> Clique numa na lista da esquerda para ver a análise.'
			return
		end
		local st = getStats(rec)
		local fr = rec.frames
		local p1, p2 = fr[1].cf.Position, fr[#fr].cf.Position
		local pct = st.straight * 100
		local col = (pct >= 98) and "rgb(60,190,115)" or ((pct >= 93) and "rgb(245,190,70)" or "rgb(232,84,84)")
		local lines = {
			"<b>" .. esc(rec.name) .. "</b>",
			string.format("Duração <b>%.1fs</b>  •  <b>%d</b> pontos (%.0f por segundo)  •  <b>%d</b> pulos", rec.duration, #fr, #fr / math.max(rec.duration, 0.01), st.jumps),
			string.format("Percurso <b>%.0f</b> studs  •  do início ao fim em linha reta <b>%.0f</b> studs", st.length, (p2 - p1).Magnitude),
			string.format("Velocidade média <b>%.1f</b>  •  máxima <b>%.1f</b> studs/s", st.avgSpeed, st.maxSpeed),
			string.format('Retidão do trajeto: <font color="%s"><b>%.0f%%</b></font>  (100%% = sem tremido; melhore em «Linhas mais retas»)', col, pct),
		}
		if rec.undo then
			lines[#lines + 1] = string.format("Versão anterior guardada: <b>%.1fs</b>  (linha cinza no mapa; «Desfazer» na aba Regravar)", rec.undo.duration)
		else
			lines[#lines + 1] = '<font color="rgb(150,158,180)">Sem versão anterior (nenhuma edição para desfazer).</font>'
		end
		local _, _, root = getCharacter()
		if root then
			lines[#lines + 1] = string.format('<font color="rgb(150,158,180)">Você está a %.1f studs do início e a %.1f do fim.</font>', (root.Position - p1).Magnitude, (root.Position - p2).Magnitude)
		end
		lines[#lines + 1] = '<font color="rgb(150,158,180)">Mapa 3D: 🟢 início  🔴 fim  🟡 pulos  ⚪ você  •  arraste para girar, scroll para zoom</font>'
		ui.anaInfo.Text = table.concat(lines, "\n")
	end

	ui.updateAnalysisLive = function()
		local _, _, root = getCharacter()
		if root and ui.mapPlayerPart then
			ui.mapPlayerPart.CFrame = CFrame.new(root.Position)
		end
	end
end)
